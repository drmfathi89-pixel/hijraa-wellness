# Written by `neon env pull` / `neon deploy` (see neon.ts). On Vercel, set these in Project > Settings > Environment Variables.
NEON_BRANCH=production
# Pooled connection string (app runtime)
DATABASE_URL=postgresql://USER:PASSWORD@ep-xxxx-pooler.REGION.aws.neon.tech/neondb?sslmode=require
# Direct connection string (migrations)
DATABASE_URL_UNPOOLED=postgresql://USER:PASSWORD@ep-xxxx.REGION.aws.neon.tech/neondb?sslmode=require
# Optional. Signs login sessions; if unset, a key is derived from DATABASE_URL.
# Set one (openssl rand -base64 32) to sign everyone out independently of the DB password.
# AUTH_SECRET=
